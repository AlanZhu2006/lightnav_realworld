[Unit]
Description=LightNav real-world inference server
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/lightnav_realworld
ExecStart=/ABSOLUTE/PATH/lightnav_realworld/deployment/server/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
[Install]
WantedBy=default.target
