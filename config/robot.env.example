# Copy to config/robot.env on the Jetson; set the GPU workstation URL.
LIGHTNAV_SERVER_URL="${LIGHTNAV_SERVER_URL:-}"
LIGHTNAV_ROBOT_VENV="${LIGHTNAV_ROBOT_VENV:-${LIGHTNAV_REPO_ROOT}/.venv-robot}"
LIGHTNAV_ROS_SETUP="${LIGHTNAV_ROS_SETUP:-/opt/ros/humble/setup.bash}"
LIGHTNAV_CYCLONEDDS_HOME="${LIGHTNAV_CYCLONEDDS_HOME:-}"
LIGHTNAV_REALSENSE_SETUP="${LIGHTNAV_REALSENSE_SETUP:-}"
LIGHTNAV_NETWORK_INTERFACE="${LIGHTNAV_NETWORK_INTERFACE:-enP8p1s0}"
LIGHTNAV_IMAGE_TOPIC="${LIGHTNAV_IMAGE_TOPIC:-/camera/camera/color/image_raw}"
LIGHTNAV_IMAGE_TRANSPORT="${LIGHTNAV_IMAGE_TRANSPORT:-raw}"
LIGHTNAV_LINEAR_LIMIT="${LIGHTNAV_LINEAR_LIMIT:-0.3}"
LIGHTNAV_ANGULAR_LIMIT="${LIGHTNAV_ANGULAR_LIMIT:-0.5}"
LIGHTNAV_WEB_HOST="${LIGHTNAV_WEB_HOST:-0.0.0.0}"
LIGHTNAV_WEB_PORT="${LIGHTNAV_WEB_PORT:-8088}"
LIGHTNAV_RECORDINGS_DIR="${LIGHTNAV_RECORDINGS_DIR:-${LIGHTNAV_REPO_ROOT}/recordings}"
ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
LIGHTNAV_FASTDDS_PROFILE="${LIGHTNAV_FASTDDS_PROFILE:-${LIGHTNAV_REPO_ROOT}/config/fastdds-camera.xml}"
