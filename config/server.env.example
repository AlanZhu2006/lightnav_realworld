# Copy to config/server.env on the GPU workstation.
LIGHTNAV_MODEL_PATH="${LIGHTNAV_MODEL_PATH:-${LIGHTNAV_REPO_ROOT}/checkpoints/LightNav-0}"
LIGHTNAV_SERVER_PYTHON="${LIGHTNAV_SERVER_PYTHON:-${LIGHTNAV_REPO_ROOT}/.venv-server/bin/python}"
LIGHTNAV_BACKEND="${LIGHTNAV_BACKEND:-vllm_local}"
LIGHTNAV_TASK="${LIGHTNAV_TASK:-vln}"
LIGHTNAV_HOST="${LIGHTNAV_HOST:-0.0.0.0}"
LIGHTNAV_PORT="${LIGHTNAV_PORT:-8050}"
LIGHTNAV_GPU="${LIGHTNAV_GPU:-0}"
LIGHTNAV_GPU_MEMORY_UTILIZATION="${LIGHTNAV_GPU_MEMORY_UTILIZATION:-0.55}"
LIGHTNAV_MAX_BATCH_SIZE="${LIGHTNAV_MAX_BATCH_SIZE:-1}"
LIGHTNAV_VIT_CACHE_ENTRIES="${LIGHTNAV_VIT_CACHE_ENTRIES:-256}"
LIGHTNAV_SERVER_RECORDINGS="${LIGHTNAV_SERVER_RECORDINGS:-${LIGHTNAV_REPO_ROOT}/recordings-inference}"
LIGHTNAV_HOST_TELEMETRY="${LIGHTNAV_HOST_TELEMETRY:-1}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
